# Local development only. Never commit real secrets.
# The local Express backend reads TRIPO_API_KEY server-side.
TRIPO_API_KEY=

# Optional: change the local API origin. Leave empty to use the Vite /api proxy.
VITE_API_BASE_URL=

# Lovable Cloud / Supabase. These are safe frontend configuration values.
# Get them from the Lovable project .env after connecting Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
